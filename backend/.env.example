# Copy this file to .env for local/Replit development.
# Never commit your real .env file.

# Gemini API key from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# Shared secret between backend and extension settings.
# Generate one with: openssl rand -hex 32
AUTH_TOKEN=your_auth_token_here

# Local development only. Northflank injects PORT automatically.
PORT=3000
NODE_ENV=development

# Optional CORS allow-list. Use * for dev/hybrid Chrome extension usage.
# For stricter production, use comma-separated origins.
CORS_ORIGIN=*
